#include <windows.h>

/* identity shown by Explorer, Task Manager and the UAC prompt */
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"          /* zh-CN, Unicode */
        BEGIN
            VALUE "CompanyName",      "kwifi"
            VALUE "FileDescription",  "kwifi 热点控制台"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "kwifi"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "kwifi.exe"
            VALUE "ProductName",      "kwifi"
            VALUE "ProductVersion",   "1.0.0.0"
        END
        BLOCK "040904b0"          /* en-US, Unicode */
        BEGIN
            VALUE "CompanyName",      "kwifi"
            VALUE "FileDescription",  "kwifi hotspot console"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "kwifi"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "kwifi.exe"
            VALUE "ProductName",      "kwifi"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200, 0x0409, 1200
    END
END

/* icon: 1 = tray/exe icon, picked up by Explorer and Shell_NotifyIcon fallback */
1 ICON "app.ico"

/* manifest: asInvoker because the app raises itself with runas when needed */
1 RT_MANIFEST "app.manifest"
